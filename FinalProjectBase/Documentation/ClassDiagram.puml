@startuml
title Data Processing and Quality Platform - Class Diagram

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
left to right direction

package Models {
    class Dataset {
        +Name : string
        +Columns : List<ColumnDefinition>
        +Records : List<DataRecord>
    }

    class ColumnDefinition {
        +Name : string
        +DetectedType : DataType
        +IsNullable : bool
    }

    class DataRecord {
        +RowNumber : int
        +Values : Dictionary<string, string?>
    }

    class QualityIssue {
        +RowNumber : int
        +ColumnName : string
        +RuleName : string
        +InvalidValue : string?
        +Message : string
        +Severity : IssueSeverity
    }

    class QualityReport {
        +DatasetName : string
        +ExecutionDate : DateTime
        +InitialRecordCount : int
        +FinalRecordCount : int
        +InitialScore : double
        +FinalScore : double
        +DetectedIssues : List<QualityIssue>
        +AppliedTransformations : List<string>
    }

    class DatasetProfile {
        +DatasetName : string
        +RowCount : int
        +ColumnCount : int
        +ColumnStatistics : Dictionary
    }

    class QualityRuleConfiguration {
        +Type : QualityRuleType
        +ColumnName : string
        +IsCritical : bool
        +Minimum : decimal?
        +Maximum : decimal?
        +Pattern : string?
    }

    enum QualityRuleType {
        MissingValue
        UniqueValue
        Range
        Regex
        DateFormat
    }

    enum IssueSeverity {
        Information
        Warning
        Error
    }

    enum DataType {
        String
        Integer
        Decimal
        Date
        Boolean
    }

    Dataset "1" *-- "*" ColumnDefinition
    Dataset "1" *-- "*" DataRecord
    QualityIssue --> IssueSeverity
    ColumnDefinition --> DataType
    QualityRuleConfiguration --> QualityRuleType
    QualityReport o-- QualityIssue
}

package DataSources {
    interface IDataSource {
        +Load(path : string) : Dataset
    }

    class CsvDataSource {
        +Load(path : string) : Dataset
    }

    class LegacyCsvReader {
        +ReadFile(path : string) : string[]
    }

    class LegacyCsvReaderAdapter {
        -legacyReader : LegacyCsvReader
        +Load(path : string) : Dataset
    }

    IDataSource <|.. CsvDataSource
    IDataSource <|.. LegacyCsvReaderAdapter
    LegacyCsvReaderAdapter --> LegacyCsvReader : adapts
}

package Quality {
    interface IQualityRule {
        +Name : string
        +ColumnName : string
        +IsCritical : bool
        +Evaluate(dataset : Dataset) : List<QualityIssue>
    }

    abstract class QualityRule {
        +Name : string
        +ColumnName : string
        +IsCritical : bool
        #GetValue(record : DataRecord) : string?
        +Evaluate(dataset : Dataset) : List<QualityIssue>
    }

    class MissingValueRule
    class UniqueValueRule
    class RangeRule {
        +Minimum : decimal
        +Maximum : decimal
    }

    class RegexRule {
        +Pattern : string
    }

    class DateFormatRule {
        +RequiredFormat : string
    }

    IQualityRule <|.. QualityRule
    QualityRule <|-- MissingValueRule
    QualityRule <|-- UniqueValueRule
    QualityRule <|-- RangeRule
    QualityRule <|-- RegexRule
    QualityRule <|-- DateFormatRule
}

package Transformations {
    interface IDataTransformation {
        +Name : string
        +Apply(dataset : Dataset) : Dataset
    }

    class TrimStringTransformation
    class NormalizeCountryTransformation

    class RemoveDuplicateTransformation {
        +ColumnName : string
    }

    class RemoveInvalidRecordTransformation {
        -issues : List<QualityIssue>
    }

    IDataTransformation <|.. TrimStringTransformation
    IDataTransformation <|.. NormalizeCountryTransformation
    IDataTransformation <|.. RemoveDuplicateTransformation
    IDataTransformation <|.. RemoveInvalidRecordTransformation

    RemoveInvalidRecordTransformation --> QualityIssue
}

package Services {
    class DatasetProfiler {
        +Profile(dataset : Dataset) : DatasetProfile
    }

    class QualityAnalyzer {
        +Analyze(dataset : Dataset, rules) : List<QualityIssue>
    }

    class QualityScoreCalculator {
        +Calculate(dataset : Dataset, issues) : double
    }

    class TransformationHistory {
        -history : Stack<Dataset>
        +CanUndo : bool
        +Save(dataset : Dataset) : void
        +Undo() : Dataset
    }

    class ProcessingPipeline {
        -transformations : List<IDataTransformation>
        -observers : List<IPipelineObserver>
        +TransformationNames : IReadOnlyList<string>
        +AddTransformation(transformation) : void
        +AddObserver(observer) : void
        +Execute(dataset : Dataset) : Dataset
    }

    QualityAnalyzer --> IQualityRule
    ProcessingPipeline o-- IDataTransformation
    ProcessingPipeline --> TransformationHistory
}

package Observers {
    interface IPipelineObserver {
        +OnStepStarted(stepName : string) : void
        +OnStepCompleted(stepName : string, recordCount : int) : void
        +OnStepFailed(stepName : string, exception : Exception) : void
    }

    class ConsolePipelineObserver

    IPipelineObserver <|.. ConsolePipelineObserver
    ProcessingPipeline o-- IPipelineObserver
}

package Factories {
    class QualityRuleFactory {
        +Create(configuration : QualityRuleConfiguration) : IQualityRule
    }

    QualityRuleFactory --> QualityRuleConfiguration
    QualityRuleFactory --> IQualityRule : creates
}

package Exporters {
    interface IDataExporter {
        +FormatName : string
        +Export(dataset : Dataset, path : string) : void
    }

    class CsvDataExporter
    class JsonDataExporter

    IDataExporter <|.. CsvDataExporter
    IDataExporter <|.. JsonDataExporter
}

package Persistence {
    class DataQualityContext {
        +ProcessingRuns
        +QualityIssues
        +QualityRuleConfigurations
    }

    class ProcessingRunEntity {
        +Id : int
        +DatasetName : string
        +StartedAt : DateTime
        +CompletedAt : DateTime?
        +Status : string
        +InputRecordCount : int
        +OutputRecordCount : int
        +QualityScore : double
    }

    class QualityIssueEntity {
        +Id : int
        +ProcessingRunEntityId : int
        +RowNumber : int
        +ColumnName : string
        +RuleName : string
        +InvalidValue : string?
        +Message : string
        +Severity : IssueSeverity
    }

    class QualityRuleConfigurationEntity {
        +Id : int
        +Name : string
        +RuleType : QualityRuleType
        +ColumnName : string
        +IsCritical : bool
        +Minimum : decimal?
        +Maximum : decimal?
        +Pattern : string?
    }

    DataQualityContext o-- ProcessingRunEntity
    DataQualityContext o-- QualityIssueEntity
    DataQualityContext o-- QualityRuleConfigurationEntity

    ProcessingRunEntity "1" *-- "*" QualityIssueEntity
    QualityRuleConfigurationEntity --> QualityRuleType
    QualityIssueEntity --> IssueSeverity
}

package Repositories {
    interface IProcessingRunRepository {
        +Add(run : ProcessingRunEntity) : void
        +GetById(id : int) : ProcessingRunEntity?
        +GetAll() : List<ProcessingRunEntity>
        +Update(run : ProcessingRunEntity) : void
        +Delete(id : int) : void
    }

    class EfProcessingRunRepository

    interface IQualityRuleRepository {
        +Add(configuration) : void
        +GetById(id : int) : QualityRuleConfigurationEntity?
        +GetAll() : List<QualityRuleConfigurationEntity>
        +Update(configuration) : void
        +Delete(id : int) : void
    }

    class EfQualityRuleRepository

    IProcessingRunRepository <|.. EfProcessingRunRepository
    IQualityRuleRepository <|.. EfQualityRuleRepository

    EfProcessingRunRepository --> DataQualityContext
    EfQualityRuleRepository --> DataQualityContext
}

package MVC {
    class ConsoleView {
        +DisplayMenu() : void
        +ReadMenuChoice() : string
        +ReadFilePath() : string
        +ReadInput(prompt : string) : string
        +DisplayDatasetPreview(dataset) : void
        +DisplayProfile(profile) : void
        +DisplayQualityReport(report) : void
        +DisplayExecutionHistory(runs) : void
        +DisplayQualityRuleConfigurations(configurations) : void
    }

    class DataProcessingController {
        +Run() : void
        -LoadDataset() : void
        -ShowPreview() : void
        -ShowProfile() : void
        -RunQualityChecks() : void
        -ApplyTransformations() : void
        -ShowQualityReport() : void
        -ExportDataset() : void
        -ShowExecutionHistory() : void
        -UndoLastTransformation() : void
        -ManageQualityRules() : void
    }

    class Program
}

DataProcessingController --> IDataSource
DataProcessingController --> ConsoleView
DataProcessingController --> DatasetProfiler
DataProcessingController --> QualityAnalyzer
DataProcessingController --> ProcessingPipeline
DataProcessingController --> QualityScoreCalculator
DataProcessingController --> IProcessingRunRepository
DataProcessingController --> IQualityRuleRepository
DataProcessingController --> IQualityRule
DataProcessingController --> IDataExporter
DataProcessingController --> TransformationHistory
DataProcessingController --> QualityRuleFactory

Program --> DataProcessingController : creates

ConsoleView --> Dataset
ConsoleView --> DatasetProfile
ConsoleView --> QualityReport
ConsoleView --> ProcessingRunEntity
ConsoleView --> QualityRuleConfigurationEntity

@enduml