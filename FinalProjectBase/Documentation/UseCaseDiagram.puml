@startuml
title Data Processing and Quality Platform - Use Case Diagram

left to right direction

actor "Data User" as User

rectangle "Data Processing and Quality Platform" {
    usecase "Load CSV Dataset" as Load
    usecase "Preview First 10 Records" as Preview
    usecase "Generate Dataset Profile" as Profile
    usecase "Manage Quality Rules" as ManageRules
    usecase "Create Rule" as CreateRule
    usecase "List Rules" as ListRules
    usecase "Update Rule" as UpdateRule
    usecase "Delete Rule" as DeleteRule
    usecase "Run Quality Checks" as QualityChecks
    usecase "Calculate Quality Score" as Score
    usecase "Apply Transformations" as Transform
    usecase "Remove Duplicate Records" as RemoveDuplicates
    usecase "Remove Invalid Records" as RemoveInvalid
    usecase "Undo Transformation" as Undo
    usecase "Export Dataset to CSV" as ExportCsv
    usecase "Export Dataset to JSON" as ExportJson
    usecase "View Quality Report" as Report
    usecase "View Processing History" as History
    usecase "Store Processing Run" as StoreRun
}

User --> Load
User --> Preview
User --> Profile
User --> ManageRules
User --> QualityChecks
User --> Transform
User --> Undo
User --> ExportCsv
User --> ExportJson
User --> Report
User --> History

ManageRules .> CreateRule : <<include>>
ManageRules .> ListRules : <<include>>
ManageRules .> UpdateRule : <<include>>
ManageRules .> DeleteRule : <<include>>

QualityChecks .> Score : <<include>>
Transform .> RemoveDuplicates : <<include>>
Transform .> RemoveInvalid : <<include>>
Transform .> StoreRun : <<include>>
Report .> Score : <<include>>

@enduml